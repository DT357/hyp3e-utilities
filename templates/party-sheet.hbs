<section
  class="hyp3e-utilities__party-sheet"
  aria-label="{{localize "hyp3e-utilities.applications.partySheet.title"}}"
>
  <header class="hyp3e-utilities__party-summary">
    <span>{{localize "hyp3e-utilities.applications.partySheet.revision" revision=state.revision}}</span>
    <span class="hyp3e-utilities__party-access">
      {{#if canEdit}}
        {{localize "hyp3e-utilities.applications.partySheet.editable"}}
      {{else}}
        {{localize "hyp3e-utilities.applications.partySheet.readOnly"}}
      {{/if}}
    </span>
    {{#if hasUnsavedChanges}}
      <aside class="hyp3e-utilities__party-draft-status" role="status">
        {{#if hasStaleDraft}}
          <strong>{{localize "hyp3e-utilities.applications.partySheet.staleDraft"}}</strong>
        {{else}}
          <span>{{localize "hyp3e-utilities.applications.partySheet.unsavedDraft"}}</span>
        {{/if}}
        <button type="button" data-action="discardPartyDrafts">
          {{localize "hyp3e-utilities.applications.partySheet.discardDrafts"}}
        </button>
      </aside>
    {{/if}}
  </header>

  <nav
    class="hyp3e-utilities__party-tabs"
    aria-label="{{localize "hyp3e-utilities.applications.partySheet.navigation"}}"
    role="tablist"
  >
    {{#each tabs}}
      <button
        type="button"
        class="{{#if active}}active{{/if}}"
        data-action="selectTab"
        data-tab="{{id}}"
        id="hyp3e-utilities-party-tab-{{id}}"
        role="tab"
        aria-controls="hyp3e-utilities-party-tab-panel"
        aria-selected="{{#if active}}true{{else}}false{{/if}}"
        tabindex="{{#if active}}0{{else}}-1{{/if}}"
      >{{localize label}}</button>
    {{/each}}
  </nav>

  <section
    class="hyp3e-utilities__party-panel"
    id="hyp3e-utilities-party-tab-panel"
    role="tabpanel"
    aria-labelledby="hyp3e-utilities-party-tab-{{activeTab.id}}"
    tabindex="0"
  >
    <h2>{{localize activeTab.label}}</h2>
    {{#if showOverview}}
      <section
        class="hyp3e-utilities__party-overview"
        data-party-member-drop-zone
      >
        {{#if canEdit}}
          <div class="hyp3e-utilities__party-toolbar">
            <button type="button" data-action="addSelectedActor">
              <i class="fa-solid fa-user-check" aria-hidden="true"></i>
              {{localize "hyp3e-utilities.applications.partySheet.addSelectedActor"}}
            </button>
            <button type="button" data-action="addControlledMembers">
              <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
              {{localize "hyp3e-utilities.applications.partySheet.addControlledMembers"}}
            </button>
            <span>{{localize "hyp3e-utilities.applications.partySheet.dropActors"}}</span>
          </div>
        {{/if}}

        {{#if canDistributeXp}}
          <section class="hyp3e-utilities__party-xp" data-party-xp>
            <h3>{{localize "hyp3e-utilities.applications.partySheet.xpHeading"}}</h3>
            <p>{{localize "hyp3e-utilities.applications.partySheet.xpHelp"}}</p>
            <label class="hyp3e-utilities__party-xp-total">
              <span>{{localize "hyp3e-utilities.applications.partySheet.xpTotal"}}</span>
              <input
                type="number"
                min="0"
                step="1"
                inputmode="numeric"
                value="{{xpTotal}}"
                data-xp-total
              >
            </label>
            {{#if hasXpRecipients}}
              <fieldset class="hyp3e-utilities__party-xp-recipients">
                <legend>{{localize "hyp3e-utilities.applications.partySheet.xpRecipients"}}</legend>
                {{#each xpDistributions}}
                  <label>
                    <input
                      type="checkbox"
                      data-xp-recipient
                      data-actor-uuid="{{actorUuid}}"
                      {{#if selected}}checked{{/if}}
                      {{#if missing}}disabled{{/if}}
                    >
                    <span>{{name}}</span>
                    <small>{{localize "hyp3e-utilities.applications.partySheet.xpShare" share=share}}</small>
                  </label>
                {{/each}}
              </fieldset>
              <button type="button" data-action="previewXp">
                {{localize "hyp3e-utilities.applications.partySheet.xpPreviewAction"}}
              </button>
            {{else}}
              <p role="status">{{localize "hyp3e-utilities.applications.partySheet.xpNoRecipients"}}</p>
            {{/if}}
            {{#if xpPreviewReady}}
              {{#if xpPreviewStale}}
                <p class="hyp3e-utilities__party-xp-warning" role="status">
                  {{localize "hyp3e-utilities.applications.partySheet.xpPreviewStale"}}
                </p>
              {{/if}}
              <dl class="hyp3e-utilities__party-xp-summary">
                <div><dt>{{localize "hyp3e-utilities.applications.partySheet.xpTotalShares"}}</dt><dd>{{xpPreview.totalShares}}</dd></div>
                <div><dt>{{localize "hyp3e-utilities.applications.partySheet.xpRemainder"}}</dt><dd>{{xpPreview.baseRemainderXp}}</dd></div>
              </dl>
              <div class="hyp3e-utilities__party-xp-table-wrap">
                <table class="hyp3e-utilities__party-xp-table">
                  <thead>
                    <tr>
                      <th scope="col">{{localize "hyp3e-utilities.applications.partySheet.xpRecipient"}}</th>
                      <th scope="col">{{localize "hyp3e-utilities.applications.partySheet.xpBase"}}</th>
                      <th scope="col">{{localize "hyp3e-utilities.applications.partySheet.xpAdjustment"}}</th>
                      <th scope="col">{{localize "hyp3e-utilities.applications.partySheet.xpAward"}}</th>
                      <th scope="col">{{localize "hyp3e-utilities.applications.partySheet.xpWriteback"}}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each xpPreview.distributions}}
                      {{#if included}}
                        <tr>
                          <th scope="row">{{name}}</th>
                          <td>{{baseXp}}</td>
                          <td>{{adjustmentLabel}}</td>
                          <td>{{finalAwardXp}}</td>
                          <td>{{localize writebackLabel}}</td>
                        </tr>
                      {{/if}}
                    {{/each}}
                  </tbody>
                </table>
              </div>
              <button
                type="button"
                data-action="distributeXp"
                {{#unless canConfirmXp}}disabled{{/unless}}
              >{{localize "hyp3e-utilities.applications.partySheet.xpConfirmAction"}}</button>
            {{/if}}
          </section>
        {{/if}}

        {{#if hasMembers}}
          <ol class="hyp3e-utilities__party-members">
            {{#each members}}
              <li
                class="hyp3e-utilities__party-member {{#if missing}}hyp3e-utilities__party-member--missing{{/if}}"
                data-party-actor-row
              >
                {{#if missing}}
                  <img
                    class="hyp3e-utilities__party-member-portrait-image"
                    src="{{img}}"
                    alt=""
                    width="40"
                    height="40"
                  >
                {{else}}
                  <button
                    type="button"
                    class="hyp3e-utilities__party-member-portrait"
                    data-action="pingActor"
                    data-actor-uuid="{{actorUuid}}"
                    data-tooltip="{{localize "hyp3e-utilities.applications.partySheet.pingTokenFor" name=name}}"
                    aria-label="{{localize "hyp3e-utilities.applications.partySheet.pingTokenFor" name=name}}"
                  >
                    <img
                      class="hyp3e-utilities__party-member-portrait-image"
                      src="{{img}}"
                      alt=""
                      width="40"
                      height="40"
                    >
                  </button>
                {{/if}}
                <div class="hyp3e-utilities__party-member-identity">
                  {{#if missing}}
                    <strong>{{name}}</strong>
                    <span>{{localize "hyp3e-utilities.applications.partySheet.missingReference"}}</span>
                  {{else}}
                    <button
                      type="button"
                      class="hyp3e-utilities__party-member-link"
                      data-action="openMember"
                      data-actor-uuid="{{actorUuid}}"
                    >{{name}}</button>
                    <span>{{race}} · {{className}} {{level}}</span>
                    {{#if invalidType}}
                      <span>{{localize "hyp3e-utilities.applications.partySheet.invalidMemberType"}}</span>
                    {{/if}}
                  {{/if}}
                </div>
                {{#unless missing}}
                  <dl class="hyp3e-utilities__party-member-stats hyp3e-utilities__party-member-stats--overview">
                    <div class="hyp3e-utilities__party-member-stat--hp"><dt>{{localize "hyp3e-utilities.applications.partySheet.hp"}}</dt><dd>{{summary.hp.value}}/{{summary.hp.max}}</dd></div>
                    <div class="hyp3e-utilities__party-member-stat--ac"><dt>{{localize "hyp3e-utilities.applications.partySheet.ac"}}</dt><dd>{{summary.armor.ac}}</dd></div>
                    <div class="hyp3e-utilities__party-member-stat--dr"><dt>{{localize "hyp3e-utilities.applications.partySheet.dr"}}</dt><dd>{{summary.armor.dr}}</dd></div>
                    <div class="hyp3e-utilities__party-member-stat--movement"><dt>{{localize "hyp3e-utilities.applications.partySheet.movement"}}</dt><dd>{{summary.movement}}</dd></div>
                    <div class="hyp3e-utilities__party-member-stat--share"><dt>{{localize "hyp3e-utilities.applications.partySheet.share"}}</dt><dd>{{share}}</dd></div>
                  </dl>
                {{/unless}}
                {{#unless missing}}
                  {{#if ../canRollPartyActions}}
                    {{#if canRollSave}}
                      <div class="hyp3e-utilities__party-row-actions hyp3e-utilities__party-row-actions--member">
                        <button
                          type="button"
                          data-action="rollMemberSave"
                          data-actor-uuid="{{actorUuid}}"
                        >{{localize "hyp3e-utilities.applications.partySheet.rollSave"}}</button>
                      </div>
                    {{/if}}
                  {{/if}}
                {{/unless}}
                {{#if ../canEdit}}
                  {{#if missing}}
                    <button
                      type="button"
                      class="hyp3e-utilities__party-member-remove"
                      data-action="removeMember"
                      data-actor-uuid="{{actorUuid}}"
                    >{{localize "hyp3e-utilities.applications.partySheet.cleanupReference"}}</button>
                  {{else}}
                    <button
                      type="button"
                      class="hyp3e-utilities__party-member-remove hyp3e-utilities__party-member-remove--icon"
                      data-action="removeMember"
                      data-actor-uuid="{{actorUuid}}"
                      data-tooltip="{{localize "hyp3e-utilities.applications.partySheet.removeMember"}}"
                      aria-label="{{localize "hyp3e-utilities.applications.partySheet.removeMember"}}"
                    ><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                  {{/if}}
                {{/if}}
              </li>
            {{/each}}
          </ol>
        {{else}}
          <p>{{localize "hyp3e-utilities.applications.partySheet.noMembers"}}</p>
        {{/if}}
      </section>
    {{else}}
      {{#if showFollowers}}
        <section
          class="hyp3e-utilities__party-overview"
          data-party-follower-drop-zone
        >
          {{#if canEdit}}
            <div class="hyp3e-utilities__party-toolbar">
              <span>{{localize "hyp3e-utilities.applications.partySheet.dropFollowers"}}</span>
              {{#if canRollPartyActions}}
                {{#if hasFollowerMorale}}
                  <button type="button" data-action="rollAllFollowerMorale">
                    {{localize "hyp3e-utilities.applications.partySheet.rollAllMorale"}}
                  </button>
                {{/if}}
              {{/if}}
            </div>
          {{/if}}

          {{#if canPreviewWages}}
            <section class="hyp3e-utilities__party-wages" data-party-wages>
              <h3>{{localize "hyp3e-utilities.applications.partySheet.wageHeading"}}</h3>
              <p>{{localize "hyp3e-utilities.applications.partySheet.wageHelp"}}</p>
              {{#if hasWageFollowers}}
                <fieldset class="hyp3e-utilities__party-wage-followers">
                  <legend>{{localize "hyp3e-utilities.applications.partySheet.wageRecipients"}}</legend>
                  {{#each wageModel.followers}}
                    <label>
                      <input
                        type="checkbox"
                        data-wage-recipient
                        data-actor-uuid="{{actorUuid}}"
                        {{#if selected}}checked{{/if}}
                        {{#if missing}}disabled{{/if}}
                      >
                      <span>{{name}}</span>
                      <small>{{localize "hyp3e-utilities.applications.partySheet.wageAmount" wage=wageGp}}</small>
                    </label>
                  {{/each}}
                </fieldset>
                <button type="button" data-action="previewWages">
                  {{localize "hyp3e-utilities.applications.partySheet.wagePreviewAction"}}
                </button>
              {{else}}
                <p role="status">{{localize "hyp3e-utilities.applications.partySheet.wageNoFollowers"}}</p>
              {{/if}}
              {{#if wagePreviewReady}}
                {{#if wagePreviewStale}}
                  <p class="hyp3e-utilities__party-treasury-warning" role="status">
                    {{localize "hyp3e-utilities.applications.partySheet.wagePreviewStale"}}
                  </p>
                {{/if}}
                <dl class="hyp3e-utilities__party-wage-summary">
                  <div><dt>{{localize "hyp3e-utilities.applications.partySheet.wageTreasuryGp"}}</dt><dd>{{wagePreview.availableGp}}</dd></div>
                  <div><dt>{{localize "hyp3e-utilities.applications.partySheet.wageTotal"}}</dt><dd>{{wagePreview.totalDueGp}}</dd></div>
                  <div><dt>{{localize "hyp3e-utilities.applications.partySheet.wageRemaining"}}</dt><dd>{{wagePreview.remainingGp}}</dd></div>
                </dl>
                {{#unless wagePreview.enoughGp}}
                  <p class="hyp3e-utilities__party-treasury-warning" role="status">
                    {{localize "hyp3e-utilities.applications.partySheet.wageInsufficient" shortfall=wagePreview.shortfallGp}}
                  </p>
                {{/unless}}
                <button
                  type="button"
                  data-action="settleWages"
                  {{#unless canConfirmWages}}disabled{{/unless}}
                >
                  {{localize "hyp3e-utilities.applications.partySheet.wageConfirmAction"}}
                </button>
              {{/if}}
            </section>
          {{/if}}

          {{#if hasFollowers}}
            <ol class="hyp3e-utilities__party-members">
              {{#each followers}}
                <li
                  class="hyp3e-utilities__party-member hyp3e-utilities__party-follower {{#if missing}}hyp3e-utilities__party-member--missing{{/if}}"
                  data-actor-uuid="{{actorUuid}}"
                  data-follower-row
                  data-party-actor-row
                >
                  {{#if missing}}
                    <img
                      class="hyp3e-utilities__party-member-portrait-image"
                      src="{{img}}"
                      alt=""
                      width="40"
                      height="40"
                    >
                  {{else}}
                    <button
                      type="button"
                      class="hyp3e-utilities__party-member-portrait hyp3e-utilities__party-follower-portrait"
                      data-action="pingActor"
                      data-actor-uuid="{{actorUuid}}"
                      data-tooltip="{{localize "hyp3e-utilities.applications.partySheet.pingTokenFor" name=name}}"
                      aria-label="{{localize "hyp3e-utilities.applications.partySheet.pingTokenFor" name=name}}"
                    >
                      <img
                        class="hyp3e-utilities__party-member-portrait-image"
                        src="{{img}}"
                        alt=""
                        width="40"
                        height="40"
                      >
                    </button>
                  {{/if}}
                  <div class="hyp3e-utilities__party-member-identity">
                    {{#if missing}}
                      <strong>{{name}}</strong>
                      <span>{{localize "hyp3e-utilities.applications.partySheet.missingReference"}}</span>
                    {{else}}
                      <button
                        type="button"
                        class="hyp3e-utilities__party-member-link"
                        data-action="openFollower"
                        data-actor-uuid="{{actorUuid}}"
                      >{{name}}</button>
                      <span>
                        {{summary.race}} · {{summary.className}} {{summary.level}}
                        {{#if npcSubtype}} · {{npcSubtype}}{{/if}}
                      </span>
                      {{#if invalidType}}
                        <span>{{localize "hyp3e-utilities.applications.partySheet.invalidFollowerType"}}</span>
                      {{/if}}
                    {{/if}}
                  </div>
                  {{#unless missing}}
                    <dl class="hyp3e-utilities__party-member-stats hyp3e-utilities__party-member-stats--overview hyp3e-utilities__party-member-stats--follower">
                      <div class="hyp3e-utilities__party-member-stat--hp"><dt>{{localize "hyp3e-utilities.applications.partySheet.hp"}}</dt><dd>{{summary.hp.value}}/{{summary.hp.max}}</dd></div>
                      <div class="hyp3e-utilities__party-member-stat--ac"><dt>{{localize "hyp3e-utilities.applications.partySheet.ac"}}</dt><dd>{{summary.armor.ac}}</dd></div>
                      <div class="hyp3e-utilities__party-member-stat--dr"><dt>{{localize "hyp3e-utilities.applications.partySheet.dr"}}</dt><dd>{{summary.armor.dr}}</dd></div>
                      <div class="hyp3e-utilities__party-member-stat--movement"><dt>{{localize "hyp3e-utilities.applications.partySheet.movement"}}</dt><dd>{{summary.movement}}</dd></div>
                      <div class="hyp3e-utilities__party-member-stat--share">
                        <dt><label for="hyp3e-utilities-follower-share-{{@index}}">{{localize "hyp3e-utilities.applications.partySheet.share"}}</label></dt>
                        <dd>
                          {{#if ../canEdit}}
                            <input
                              id="hyp3e-utilities-follower-share-{{@index}}"
                              data-field="follower-share"
                              type="number"
                              min="0"
                              step="0.25"
                              value="{{share}}"
                            >
                          {{else}}
                            {{share}}
                          {{/if}}
                        </dd>
                      </div>
                    </dl>
                  {{/unless}}
                  {{#unless missing}}
                    <div class="hyp3e-utilities__party-employment hyp3e-utilities__party-employment--compact">
                      {{#if ../canEdit}}
                        <label for="hyp3e-utilities-follower-wage-{{@index}}">
                          {{localize "hyp3e-utilities.applications.partySheet.wageGpShort"}}
                        </label>
                        <input
                          id="hyp3e-utilities-follower-wage-{{@index}}"
                          data-field="follower-wage"
                          type="number"
                          min="0"
                          step="1"
                          value="{{wageGp}}"
                        >
                        <button
                          type="button"
                          data-action="saveFollower"
                          data-actor-uuid="{{actorUuid}}"
                          data-tooltip="{{localize "hyp3e-utilities.applications.partySheet.saveFollower"}}"
                          aria-label="{{localize "hyp3e-utilities.applications.partySheet.saveFollower"}}"
                        >{{localize "hyp3e-utilities.applications.partySheet.saveFollowerShort"}}</button>
                      {{else}}
                        <span>{{localize "hyp3e-utilities.applications.partySheet.wageGpShort"}}: {{wageGp}}</span>
                      {{/if}}
                    </div>
                    <div class="hyp3e-utilities__party-row-actions hyp3e-utilities__party-row-actions--follower">
                      {{#if ../canRollPartyActions}}
                        {{#if canRollSave}}
                          <button
                            type="button"
                            class="hyp3e-utilities__party-follower-save-action"
                            data-action="rollFollowerSave"
                            data-actor-uuid="{{actorUuid}}"
                          >{{localize "hyp3e-utilities.applications.partySheet.rollSave"}}</button>
                        {{/if}}
                        {{#if canRollMorale}}
                          <button
                            type="button"
                            class="hyp3e-utilities__party-follower-morale-action"
                            data-action="rollFollowerMorale"
                            data-actor-uuid="{{actorUuid}}"
                          >{{localize "hyp3e-utilities.applications.partySheet.rollMorale"}}</button>
                        {{/if}}
                      {{/if}}
                    </div>
                  {{/unless}}
                  {{#if ../canEdit}}
                    {{#if missing}}
                      <button
                        type="button"
                        class="hyp3e-utilities__party-member-remove"
                        data-action="removeFollower"
                        data-actor-uuid="{{actorUuid}}"
                      >{{localize "hyp3e-utilities.applications.partySheet.cleanupReference"}}</button>
                    {{else}}
                      <button
                        type="button"
                        class="hyp3e-utilities__party-member-remove hyp3e-utilities__party-member-remove--icon hyp3e-utilities__party-follower-remove--icon"
                        data-action="removeFollower"
                        data-actor-uuid="{{actorUuid}}"
                        data-tooltip="{{localize "hyp3e-utilities.applications.partySheet.removeFollower"}}"
                        aria-label="{{localize "hyp3e-utilities.applications.partySheet.removeFollower"}}"
                      ><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                    {{/if}}
                  {{/if}}
                </li>
              {{/each}}
            </ol>
          {{else}}
            <p>{{localize "hyp3e-utilities.applications.partySheet.noFollowers"}}</p>
          {{/if}}
        </section>
      {{else}}
        {{#if showMarchingOrder}}
          <section
            class="hyp3e-utilities__marching-order"
            data-party-marching-order
          >
            <p>{{localize "hyp3e-utilities.applications.partySheet.marchingHelp"}}</p>
            <button type="button" data-action="reportMarchingOrder">
              {{localize "hyp3e-utilities.applications.partySheet.reportMarchingOrder"}}
            </button>
            <div class="hyp3e-utilities__marching-groups">
              {{#each marchingGroups}}
                <section
                  class="hyp3e-utilities__marching-group"
                  data-marching-rank="{{id}}"
                  aria-label="{{localize label}}"
                >
                  <h3>{{localize label}}</h3>
                  <ol class="hyp3e-utilities__marching-rows">
                    {{#each rows}}
                      <li
                        class="hyp3e-utilities__marching-row {{#if missing}}hyp3e-utilities__party-member--missing{{/if}}"
                        data-actor-uuid="{{actorUuid}}"
                        data-marching-position="{{position}}"
                        data-marching-rank="{{rank}}"
                        data-marching-row
                        draggable="{{#if @root.canEdit}}true{{else}}false{{/if}}"
                      >
                        <img src="{{img}}" alt="" width="36" height="36">
                        <div class="hyp3e-utilities__marching-identity">
                          {{#if missing}}
                            <strong>{{name}}</strong>
                            <span>{{localize "hyp3e-utilities.applications.partySheet.missingReference"}}</span>
                          {{else}}
                            <button
                              type="button"
                              data-action="openMarchingActor"
                              data-actor-uuid="{{actorUuid}}"
                            >{{name}}</button>
                          {{/if}}
                        </div>
                        {{#if @root.canEdit}}
                          <div class="hyp3e-utilities__marching-controls">
                            <button
                              type="button"
                              data-action="moveMarchingActor"
                              data-actor-uuid="{{actorUuid}}"
                              data-target-rank="{{rank}}"
                              data-target-position="{{upPosition}}"
                              {{#unless canMoveUp}}disabled{{/unless}}
                            >{{localize "hyp3e-utilities.applications.partySheet.moveUp"}}</button>
                            <button
                              type="button"
                              data-action="moveMarchingActor"
                              data-actor-uuid="{{actorUuid}}"
                              data-target-rank="{{rank}}"
                              data-target-position="{{downPosition}}"
                              {{#unless canMoveDown}}disabled{{/unless}}
                            >{{localize "hyp3e-utilities.applications.partySheet.moveDown"}}</button>
                            <button
                              type="button"
                              data-action="moveMarchingActor"
                              data-actor-uuid="{{actorUuid}}"
                              data-target-rank="{{previousRank}}"
                              {{#unless canMovePrevious}}disabled{{/unless}}
                            >{{localize "hyp3e-utilities.applications.partySheet.movePrevious"}}</button>
                            <button
                              type="button"
                              data-action="moveMarchingActor"
                              data-actor-uuid="{{actorUuid}}"
                              data-target-rank="{{nextRank}}"
                              {{#unless canMoveNext}}disabled{{/unless}}
                            >{{localize "hyp3e-utilities.applications.partySheet.moveNext"}}</button>
                          </div>
                        {{/if}}
                      </li>
                    {{else}}
                      <li class="hyp3e-utilities__marching-empty">
                        {{localize "hyp3e-utilities.applications.partySheet.noMarchingActors"}}
                      </li>
                    {{/each}}
                  </ol>
                  {{#if acceptsNotes}}
                    <div class="hyp3e-utilities__marching-note">
                      <label for="hyp3e-utilities-marching-note-{{id}}">
                        {{localize "hyp3e-utilities.applications.partySheet.marchingNote"}}
                      </label>
                      {{#if @root.canEdit}}
                        <textarea
                          id="hyp3e-utilities-marching-note-{{id}}"
                          data-field="marching-note"
                        >{{notes}}</textarea>
                        <button
                          type="button"
                          data-action="saveMarchingNote"
                          data-marching-rank="{{id}}"
                        >{{localize "hyp3e-utilities.applications.partySheet.saveMarchingNote"}}</button>
                      {{else}}
                        <p>{{notes}}</p>
                      {{/if}}
                    </div>
                  {{/if}}
                </section>
              {{/each}}
            </div>
          </section>
        {{else}}
          {{#if showSupplies}}
            <section class="hyp3e-utilities__supplies" data-party-supplies>
              <p>{{localize "hyp3e-utilities.applications.partySheet.suppliesHelp"}}</p>
              <div class="hyp3e-utilities__supply-grid">
                <label>
                  <span>{{localize "hyp3e-utilities.applications.partySheet.supplyFields.torches"}}</span>
                  {{#if canEdit}}
                    <input type="number" min="0" step="1" data-field="torches" value="{{supplies.torches}}">
                  {{else}}
                    <output>{{supplies.torches}}</output>
                  {{/if}}
                </label>
                <label>
                  <span>{{localize "hyp3e-utilities.applications.partySheet.supplyFields.lanterns"}}</span>
                  {{#if canEdit}}
                    <input type="number" min="0" step="1" data-field="lanterns" value="{{supplies.lanterns}}">
                  {{else}}
                    <output>{{supplies.lanterns}}</output>
                  {{/if}}
                </label>
                <label>
                  <span>{{localize "hyp3e-utilities.applications.partySheet.supplyFields.oil"}}</span>
                  {{#if canEdit}}
                    <input type="number" min="0" step="1" data-field="oil" value="{{supplies.oil}}">
                  {{else}}
                    <output>{{supplies.oil}}</output>
                  {{/if}}
                </label>
                <label>
                  <span>{{localize "hyp3e-utilities.applications.partySheet.supplyFields.rations"}}</span>
                  {{#if canEdit}}
                    <input type="number" min="0" step="1" data-field="rations" value="{{supplies.rations}}">
                  {{else}}
                    <output>{{supplies.rations}}</output>
                  {{/if}}
                </label>
              </div>
              {{#if canEdit}}
                <button type="button" data-action="saveSupplies">
                  {{localize "hyp3e-utilities.applications.partySheet.saveSupplies"}}
                </button>
              {{/if}}
              <section
                class="hyp3e-utilities__treasury-inventory"
                data-treasury-inventory
                data-party-treasury-drop-zone
              >
                <h3>{{localize "hyp3e-utilities.applications.partySheet.inventoryHeading"}}</h3>
                {{#if canEdit}}
                  <p>{{localize "hyp3e-utilities.applications.partySheet.itemTransferDropHelp"}}</p>
                  {{#if hasTreasuryTransferDestinations}}
                    <label class="hyp3e-utilities__treasury-transfer-destination">
                      <span>{{localize "hyp3e-utilities.applications.partySheet.itemTransferDestination"}}</span>
                      <select data-treasury-transfer-destination>
                        {{#each treasuryTransferDestinations}}
                          <option value="{{actorUuid}}">{{name}}</option>
                        {{/each}}
                      </select>
                    </label>
                  {{/if}}
                {{/if}}
                {{#if treasury.contentsReady}}
                  {{#if treasury.hasItems}}
                    <ol class="hyp3e-utilities__treasury-items">
                      {{#each treasury.items}}
                        <li
                          data-treasury-item
                          data-item-id="{{id}}"
                          data-item-name="{{name}}"
                          data-item-quantity="{{quantity.value}}"
                          data-item-type="{{type}}"
                          data-item-uuid="{{uuid}}"
                          data-source-name="{{@root.treasury.name}}"
                          {{#if transferable}}
                            {{#if @root.canEdit}}
                              draggable="true"
                              title="{{localize 'hyp3e-utilities.applications.partySheet.itemTransferDragHelp'}}"
                            {{/if}}
                          {{/if}}
                        >
                          <img src="{{img}}" alt="" width="48" height="48">
                          <div class="hyp3e-utilities__treasury-item-identity">
                            <strong>{{name}}</strong>
                            {{#if supported}}
                              <span>{{localize typeLabel}}</span>
                              {{#if container}}
                                <span class="hyp3e-utilities__party-treasury-warning">
                                  {{localize "hyp3e-utilities.applications.partySheet.itemTransferContainerUnsupported"}}
                                </span>
                              {{/if}}
                            {{else}}
                              {{#if container}}
                                <span class="hyp3e-utilities__party-treasury-warning">
                                  {{localize "hyp3e-utilities.applications.partySheet.itemTransferContainerUnsupported"}}
                                </span>
                              {{else}}
                                <span class="hyp3e-utilities__party-treasury-warning">
                                  {{localize "hyp3e-utilities.applications.partySheet.unsupportedItemType" type=type}}
                                </span>
                              {{/if}}
                            {{/if}}
                          </div>
                          {{#if supported}}
                            <dl class="hyp3e-utilities__treasury-item-quantity">
                              <div>
                                <dt>{{localize "hyp3e-utilities.applications.partySheet.quantity"}}</dt>
                                <dd>{{quantity.value}}</dd>
                              </div>
                              {{#if hasBundle}}
                                <div>
                                  <dt>{{localize "hyp3e-utilities.applications.partySheet.bundle"}}</dt>
                                  <dd>{{quantity.bundle}}</dd>
                                </div>
                              {{/if}}
                              {{#if hasMaximum}}
                                <div>
                                  <dt>{{localize "hyp3e-utilities.applications.partySheet.maximum"}}</dt>
                                  <dd>{{quantity.max}}</dd>
                                </div>
                              {{/if}}
                            </dl>
                            {{#if transferable}}
                              {{#if @root.canEdit}}
                                <button
                                  type="button"
                                  class="hyp3e-utilities__treasury-item-take"
                                  data-action="takeTreasuryItem"
                                  data-item-uuid="{{uuid}}"
                                  {{#unless @root.hasTreasuryTransferDestinations}}disabled{{/unless}}
                                >{{localize "hyp3e-utilities.applications.partySheet.takeTreasuryItem"}}</button>
                              {{/if}}
                            {{/if}}
                          {{/if}}
                        </li>
                      {{/each}}
                    </ol>
                  {{else}}
                    <p data-empty-treasury-inventory>{{localize "hyp3e-utilities.applications.partySheet.emptyInventory"}}</p>
                  {{/if}}
                {{else}}
                  <p role="status">
                    {{#if treasury.contentsRestricted}}
                      {{localize "hyp3e-utilities.applications.partySheet.treasuryContentsRestricted"}}
                    {{else}}
                      {{#if treasury.contentsUnavailable}}
                        {{localize "hyp3e-utilities.applications.partySheet.treasuryContentsUnavailable"}}
                      {{else}}
                        {{localize "hyp3e-utilities.applications.partySheet.treasuryMissing"}}
                      {{/if}}
                    {{/if}}
                  </p>
                {{/if}}
              </section>
            </section>
          {{else}}
            {{#if showTreasure}}
              <section class="hyp3e-utilities__party-treasury" data-party-treasury>
                <h3>{{localize "hyp3e-utilities.applications.partySheet.treasuryHeading"}}</h3>
                {{#if treasury.contentsRestricted}}
                  <p role="status">
                    {{localize "hyp3e-utilities.applications.partySheet.treasuryContentsRestricted"}}
                  </p>
                {{else}}
                  {{#if treasury.contentsUnavailable}}
                    <p role="status">
                      {{localize "hyp3e-utilities.applications.partySheet.treasuryContentsUnavailable"}}
                    </p>
                  {{else}}
                    {{#if treasury.ready}}
                      <p>
                        {{localize "hyp3e-utilities.applications.partySheet.treasuryReady" name=treasury.name}}
                      </p>
                      {{#if canManageTreasury}}
                        <button type="button" data-action="openPartyTreasury">
                          {{localize "hyp3e-utilities.applications.partySheet.openTreasury"}}
                        </button>
                      {{/if}}
                    {{else}}
                      {{#if treasury.needsRecreation}}
                        <p role="status">
                          {{localize "hyp3e-utilities.applications.partySheet.treasuryMissing"}}
                        </p>
                        {{#if canManageTreasury}}
                          <button type="button" data-action="recreatePartyTreasury">
                            {{localize "hyp3e-utilities.applications.partySheet.recreateTreasury"}}
                          </button>
                        {{/if}}
                      {{/if}}
                      {{#if treasury.needsSelection}}
                        <p role="status">
                          {{localize "hyp3e-utilities.applications.partySheet.treasurySelectionRequired"}}
                        </p>
                      {{/if}}
                    {{/if}}
                  {{/if}}
                {{/if}}
                {{#if treasury.hasDuplicates}}
                  <p class="hyp3e-utilities__party-treasury-warning" role="status">
                    {{localize "hyp3e-utilities.applications.partySheet.treasuryDuplicates"}}
                  </p>
                {{/if}}
                {{#if treasury.showCandidates}}
                  <ul class="hyp3e-utilities__party-treasury-candidates">
                    {{#each treasury.candidates}}
                      <li>
                        <span>{{name}}</span>
                        {{#if bound}}
                          <strong>{{localize "hyp3e-utilities.applications.partySheet.treasuryBoundLabel"}}</strong>
                        {{else}}
                          {{#if @root.canManageTreasury}}
                            <button
                              type="button"
                              data-action="bindPartyTreasury"
                              data-actor-uuid="{{actorUuid}}"
                            >{{localize "hyp3e-utilities.applications.partySheet.bindTreasury"}}</button>
                          {{/if}}
                        {{/if}}
                      </li>
                    {{/each}}
                  </ul>
                {{/if}}
                {{#if treasury.contentsReady}}
                  <dl class="hyp3e-utilities__treasury-coins" data-treasury-coins>
                    {{#each treasury.coins}}
                      <div data-coin-key="{{id}}">
                        <dt>{{localize label}}</dt>
                        <dd>{{value}}</dd>
                      </div>
                    {{/each}}
                  </dl>
                {{/if}}
              </section>
              {{#if canPreviewCoins}}
                <section class="hyp3e-utilities__party-coins" data-party-coins>
                  <h3>{{localize "hyp3e-utilities.applications.partySheet.coinDistributionHeading"}}</h3>
                  <p>{{localize "hyp3e-utilities.applications.partySheet.coinDistributionHelp"}}</p>
                  <fieldset class="hyp3e-utilities__party-coin-amounts">
                    <legend>{{localize "hyp3e-utilities.applications.partySheet.coinSplitAmounts"}}</legend>
                    {{#each coinDenominations}}
                      <label>
                        <span>{{localize label}}</span>
                        <input
                          type="number"
                          min="0"
                          max="{{available}}"
                          step="1"
                          inputmode="numeric"
                          value="{{split}}"
                          data-coin-split="{{coinKey}}"
                        >
                        <small>{{localize "hyp3e-utilities.applications.partySheet.coinAvailable" available=available}}</small>
                      </label>
                    {{/each}}
                  </fieldset>
                  {{#if hasCoinRecipients}}
                    <fieldset class="hyp3e-utilities__party-coin-recipients">
                      <legend>{{localize "hyp3e-utilities.applications.partySheet.coinRecipients"}}</legend>
                      {{#each coinDistributions}}
                        <label>
                          <input
                            type="checkbox"
                            data-coin-recipient
                            data-actor-uuid="{{actorUuid}}"
                            {{#if selected}}checked{{/if}}
                            {{#if missing}}disabled{{/if}}
                          >
                          <span>{{name}}</span>
                          <small>{{localize "hyp3e-utilities.applications.partySheet.xpShare" share=share}}</small>
                        </label>
                      {{/each}}
                    </fieldset>
                    <button type="button" data-action="previewCoins">
                      {{localize "hyp3e-utilities.applications.partySheet.coinPreviewAction"}}
                    </button>
                  {{else}}
                    <p role="status">{{localize "hyp3e-utilities.applications.partySheet.coinNoRecipients"}}</p>
                  {{/if}}
                  {{#if coinPreviewReady}}
                    {{#if coinPreviewStale}}
                      <p class="hyp3e-utilities__party-treasury-warning" role="status">
                        {{localize "hyp3e-utilities.applications.partySheet.coinPreviewStale"}}
                      </p>
                    {{/if}}
                    <p>{{localize "hyp3e-utilities.applications.partySheet.coinTotalShares" shares=coinTotalShares}}</p>
                    <div class="hyp3e-utilities__party-coin-table-wrap">
                      <table class="hyp3e-utilities__party-coin-table">
                        <thead>
                          <tr>
                            <th scope="col">{{localize "hyp3e-utilities.applications.partySheet.coinRecipient"}}</th>
                            {{#each coinDenominations}}
                              <th scope="col">{{localize label}}</th>
                            {{/each}}
                            <th scope="col">{{localize "hyp3e-utilities.applications.partySheet.coinWriteback"}}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {{#each coinDistributions}}
                            {{#if included}}
                              <tr>
                                <th scope="row">{{name}}</th>
                                {{#each coinAwards}}<td>{{value}}</td>{{/each}}
                                <td>{{localize writebackLabel}}</td>
                              </tr>
                            {{/if}}
                          {{/each}}
                        </tbody>
                        <tfoot>
                          <tr>
                            <th scope="row">{{localize "hyp3e-utilities.applications.partySheet.coinRemainder"}}</th>
                            {{#each coinDenominations}}<td>{{remainder}}</td>{{/each}}
                            <td></td>
                          </tr>
                          <tr>
                            <th scope="row">{{localize "hyp3e-utilities.applications.partySheet.coinTreasuryRemaining"}}</th>
                            {{#each coinDenominations}}<td>{{remaining}}</td>{{/each}}
                            <td></td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                    <button
                      type="button"
                      data-action="distributeCoins"
                      {{#unless canConfirmCoins}}disabled{{/unless}}
                    >{{localize "hyp3e-utilities.applications.partySheet.coinConfirmAction"}}</button>
                  {{/if}}
                </section>
              {{/if}}
              <section class="hyp3e-utilities__party-notes" data-party-notes>
                <p>{{localize "hyp3e-utilities.applications.partySheet.treasureNotesHelp"}}</p>
                <div class="hyp3e-utilities__party-note-grid">
                  <section class="hyp3e-utilities__party-note-field">
                    <h3>{{localize "hyp3e-utilities.applications.partySheet.gemNotes"}}</h3>
                    <div
                      class="hyp3e-utilities__party-note-editor"
                      data-party-note-editor
                      data-party-note-field="gems"
                      aria-label="{{localize 'hyp3e-utilities.applications.partySheet.gemNotes'}}"
                    ></div>
                  </section>
                  <section class="hyp3e-utilities__party-note-field">
                    <h3>{{localize "hyp3e-utilities.applications.partySheet.miscTreasureNotes"}}</h3>
                    <div
                      class="hyp3e-utilities__party-note-editor"
                      data-party-note-editor
                      data-party-note-field="misc"
                      aria-label="{{localize 'hyp3e-utilities.applications.partySheet.miscTreasureNotes'}}"
                    ></div>
                  </section>
                </div>
                {{#if canEdit}}
                  <button type="button" data-action="savePartyNotes">
                    {{localize "hyp3e-utilities.applications.partySheet.saveTreasureNotes"}}
                  </button>
                {{/if}}
              </section>
            {{else}}
              {{#if showNotes}}
                <section class="hyp3e-utilities__party-notes" data-party-notes>
                  <p>{{localize "hyp3e-utilities.applications.partySheet.partyNotesHelp"}}</p>
                  <div
                    class="hyp3e-utilities__party-note-editor"
                    data-party-note-editor
                    data-party-note-field="notes"
                    aria-label="{{localize 'hyp3e-utilities.applications.partySheet.partyNotesLabel'}}"
                  ></div>
                  {{#if canEdit}}
                    <button type="button" data-action="savePartyNotes">
                      {{localize "hyp3e-utilities.applications.partySheet.savePartyNotes"}}
                    </button>
                  {{/if}}
                </section>
              {{else}}
                <p>{{localize "hyp3e-utilities.applications.partySheet.shellMessage"}}</p>
              {{/if}}
            {{/if}}
          {{/if}}
        {{/if}}
      {{/if}}
    {{/if}}
  </section>
</section>
