<section class="hyp3e-utilities-npc-action-hud" role="region" aria-labelledby="hyp3e-utilities-npc-action-hud-title">
  <header
    class="hyp3e-utilities-npc-action-hud__header"
    data-drag-handle
    title="{{localize 'hyp3e-utilities.hud.dragHandle'}}"
  >
    <div class="hyp3e-utilities-npc-action-hud__summary">
      <h2 id="hyp3e-utilities-npc-action-hud-title">{{localize "hyp3e-utilities.hud.title"}}</h2>
      <span class="hyp3e-utilities-npc-action-hud__count" aria-live="polite">
        {{localize "hyp3e-utilities.hud.selectedCount" count=selectedCount}}
      </span>
    </div>
    <div class="hyp3e-utilities-npc-action-hud__actions">
      <button type="button" data-action="reaction">
        {{localize "hyp3e-utilities.hud.reaction"}}
      </button>
      <button
        type="button"
        data-action="morale"
        {{#unless moraleAvailable}}disabled title="{{localize 'hyp3e-utilities.hud.moraleUnavailable'}}"{{/unless}}
      >
        {{localize "hyp3e-utilities.hud.morale"}}
      </button>
      <div class="hyp3e-utilities-npc-action-hud__save-action">
        <label
          class="hyp3e-utilities-npc-action-hud__save-label"
          for="hyp3e-utilities-npc-action-hud-save"
        >
          {{localize "hyp3e-utilities.hud.saveCategory"}}
        </label>
        <select
          id="hyp3e-utilities-npc-action-hud-save"
          data-role="save-category"
          {{#unless anySaveAvailable}}disabled title="{{localize 'hyp3e-utilities.hud.saveUnavailable'}}"{{/unless}}
        >
          {{#each saveOptions as |save|}}
            <option
              value="{{save.key}}"
              {{#if save.selected}}selected{{/if}}
              {{#unless save.available}}disabled{{/unless}}
            >
              {{localize save.label}}
            </option>
          {{/each}}
        </select>
        <button
          type="button"
          data-action="save"
          {{#unless saveAvailable}}disabled title="{{localize 'hyp3e-utilities.hud.saveUnavailable'}}"{{/unless}}
        >
          {{localize "hyp3e-utilities.hud.save"}}
        </button>
      </div>
    </div>
  </header>

  <ul class="hyp3e-utilities-npc-action-hud__targets">
    {{#each rows as |row|}}
      <li class="hyp3e-utilities-npc-action-hud__target" data-token-uuid="{{row.tokenUuid}}">
        <div class="hyp3e-utilities-npc-action-hud__identity">
          <button
            type="button"
            class="hyp3e-utilities-npc-action-hud__actor"
            data-action="openActorSheet"
            data-token-uuid="{{row.tokenUuid}}"
            title="{{localize 'hyp3e-utilities.hud.openActorSheet'}}"
            aria-label="{{localize 'hyp3e-utilities.hud.openActorSheetFor' name=row.name}}"
          >
            <span class="hyp3e-utilities-npc-action-hud__actor-label">{{row.name}}</span>
            <span
              class="hyp3e-utilities-npc-action-hud__actor-health"
              style="width: {{row.hp.percent}}%"
              aria-hidden="true"
            ></span>
          </button>
        </div>

        {{#if @root.displayDetailedNpcInformation}}
          <dl class="hyp3e-utilities-npc-action-hud__stats hyp3e-utilities-npc-action-hud__stats--vitals">
            <div><dt>{{localize "hyp3e-utilities.hud.hp"}}</dt><dd>{{row.hp.value}} / {{row.hp.max}}</dd></div>
            <div><dt>{{localize "hyp3e-utilities.hud.ac"}}</dt><dd>{{row.armor.ac}}</dd></div>
            <div><dt>{{localize "hyp3e-utilities.hud.dr"}}</dt><dd>{{row.armor.dr}}</dd></div>
          </dl>
          <dl class="hyp3e-utilities-npc-action-hud__stats hyp3e-utilities-npc-action-hud__stats--movement">
            <div><dt>{{localize "hyp3e-utilities.hud.movement"}}</dt><dd>{{row.movement}}</dd></div>
            <div>
              <dt>{{localize "hyp3e-utilities.hud.moraleValue"}}</dt>
              <dd>
                {{#if row.hasMorale}}
                  {{row.morale}}
                {{else}}
                  <span class="hyp3e-utilities-npc-action-hud__missing">
                    {{localize "hyp3e-utilities.hud.missingMorale"}}
                  </span>
                {{/if}}
              </dd>
            </div>
          </dl>
        {{/if}}
      </li>
    {{/each}}
  </ul>
</section>
